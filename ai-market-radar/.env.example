# ─────────────────────────────────────────────────────────────
# AI Market Radar — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA faça commit do `.env`.
# ─────────────────────────────────────────────────────────────

# Postgres (Prisma). Para o docker-compose incluso, use o host "postgres".
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"

# ─── IA (Gemini) — OPCIONAL ──────────────────────────────────
# Sem a chave, o sistema continua funcionando: as notícias são
# salvas com status "pendente de análise" (nenhum dado é inventado).
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Modelo configurável (nunca hardcoded). Ex.: gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.0-flash"

# ─── Worker de coleta ────────────────────────────────────────
# Expressão cron para o ciclo de coleta automática (node-cron).
# Padrão: a cada 15 minutos.
WORKER_FETCH_CRON="*/15 * * * *"
# Expressão cron para gerar o resumo diário. Padrão: 06:00.
WORKER_DIGEST_CRON="0 6 * * *"
# Fuso usado pelo worker/cron.
TZ="America/Sao_Paulo"
# Intervalo padrão (min) atribuído a novas fontes.
DEFAULT_FETCH_INTERVAL_MINUTES="60"

# ─── Comportamento da coleta/análise ─────────────────────────
# Rodar análise de IA logo após coletar (se a chave existir).
ANALYZE_ON_FETCH="true"
# Limite de análises de IA por ciclo (evita estourar rate limit).
MAX_ANALYZE_PER_RUN="20"
# User-Agent usado para buscar RSS/páginas (seja transparente).
HTTP_USER_AGENT="AIMarketRadar/1.0 (+https://github.com/dornelasz/priceiq-app)"
# Timeout (ms) para requisições de coleta.
FETCH_TIMEOUT_MS="15000"

# ─── Seed ────────────────────────────────────────────────────
# Se "true", o seed dispara uma coleta real ao final (requer rede).
# Padrão "false": apenas cadastra fontes/alertas, sem notícias falsas.
RUN_FETCH_ON_SEED="false"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AI Market Radar"
