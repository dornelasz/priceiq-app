# ─────────────────────────────────────────────────────────────
# AI Market Radar — variáveis de ambiente
# Copie para `.env` (cp .env.example .env) e preencha. NUNCA faça commit do `.env`.
# ─────────────────────────────────────────────────────────────

# [OBRIGATÓRIO] Conexão Postgres (Prisma).
#   Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
#   Local:   postgresql://radar:radar@localhost:5432/radar?schema=public
#   Docker:  use host "postgres" no lugar de "localhost".
#   Nuvem (Neon/Supabase): cole a connection string do projeto.
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"

# [OPCIONAL] Chave da Gemini. Sem ela o sistema funciona: as notícias são
#   salvas com status "pendente de análise" (nada é inventado).
#   Obtenha em https://aistudio.google.com/apikey e cole entre as aspas.
GEMINI_API_KEY=""

# [OPCIONAL] Intervalo padrão (em minutos) de coleta atribuído a NOVAS fontes.
#   O intervalo de cada fonte também pode ser ajustado na página "Fontes".
FETCH_INTERVAL_MINUTES="60"

# [OPCIONAL] URL pública do app (usada para montar links/integrações).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Ajustes adicionais (todos opcionais, com padrões sensatos) ──────────
# Modelo Gemini (configurável; nunca hardcoded no código).
GEMINI_MODEL="gemini-2.0-flash"
# Expressão cron do ciclo de coleta do worker (padrão: a cada 15 min).
WORKER_FETCH_CRON="*/15 * * * *"
# Expressão cron do resumo diário (padrão: 06:00).
WORKER_DIGEST_CRON="0 6 * * *"
# Fuso usado pelo worker/cron.
TZ="America/Sao_Paulo"
# Rodar análise de IA logo após coletar (se houver chave).
ANALYZE_ON_FETCH="true"
# Limite de análises de IA por ciclo (evita estourar rate limit).
MAX_ANALYZE_PER_RUN="20"
# User-Agent transparente usado ao buscar RSS/páginas.
HTTP_USER_AGENT="AIMarketRadar/1.0 (+news-aggregator)"
# Timeout (ms) das requisições de coleta.
FETCH_TIMEOUT_MS="15000"
# Se "true", o seed dispara uma coleta real ao final (requer rede). Padrão "false".
RUN_FETCH_ON_SEED="false"
# Nome exibido do app.
NEXT_PUBLIC_APP_NAME="AI Market Radar"
