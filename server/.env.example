# ════════════════════════════════════════════════════════
# PriceIQ Server — variáveis de ambiente
# ════════════════════════════════════════════════════════
# DESENVOLVIMENTO local:
#   1. Copie este arquivo para .env e ajuste se preciso
#   2. Suba Postgres + Redis: docker compose up -d (na raiz do repo)
#   3. Aplique migrations: npm run db:migrate
#   4. (opcional) Semeie fornecedores: npm run db:seed
#   5. npm run dev
#
# PRODUÇÃO (Render Web Service):
#   - NÃO commite valores reais aqui.
#   - Configure no Dashboard do Render → Environment:
#       NODE_ENV=production
#       DATABASE_URL=<DATABASE_URL do Neon, com sslmode=require>
#       FRONTEND_URL=https://priceiq.vercel.app   (ou a URL real da Vercel)
#       REDIS_URL  (opcional no MVP — cacheService cai para memória se ausente)
#   - PORT é injetada pelo Render; não precisa setar.
#   - Build Command:  npm install && npm run build
#   - Start Command:  npm run db:migrate && npm run start
#   - Root Directory: server

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend permitido em CORS.
# Em prod, troque para a URL pública da Vercel:
#   FRONTEND_URL=https://priceiq.vercel.app
FRONTEND_URL=http://localhost:5173

# === Banco de dados (Postgres) ===
# Em dev: Postgres local via docker compose.
# Em prod (Neon): postgresql://user:pass@ep-xxx.neon.tech/priceiq?sslmode=require
DATABASE_URL=postgresql://priceiq:priceiq@localhost:5432/priceiq

# === Cache (Redis) ===
# Em dev: Redis local via docker compose.
# Em prod: deixe vazio no MVP — cacheService usa fallback em memória
# automaticamente. Para escalar mais tarde, usar Upstash Redis.
REDIS_URL=redis://localhost:6379

# === Gemini (OPCIONAL — desligado por padrão) ===
# O PriceIQ NÃO depende de IA. Scrapers + extração direta + Jina + Playwright
# são o motor principal. Gemini é apenas interpretador de fallback opcional.
# Se a chave/quota acabar, a busca SEGUE FUNCIONANDO normalmente.
GEMINI_ENABLED=false
GEMINI_OPTIONAL=true
USE_GEMINI_AS_FALLBACK_ONLY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# === Cotação ===
# Cotação 100% automática via Investing.com
# Não usa Gemini, não usa AwesomeAPI e não usa cotação manual
RATES_CACHE_TTL_SECONDS=60
CURRENCY_REFRESH_INTERVAL_MS=60000
INVESTING_REFRESH_INTERVAL_MS=60000

# === Busca ===
# Motor Universal — usa fetch direto → Jina Reader → Playwright em cascata.
# Não há modos visíveis ao usuário; tudo decide internamente.
#
# Timeout por fornecedor em ms (impede uma falha derrubar toda a busca)
SUPPLIER_TIMEOUT_MS=30000
SCRAPER_TIMEOUT_MS=45000
# Máximo de fornecedores em paralelo
SEARCH_CONCURRENCY=5
# Match score: ≥75 confiável · 50–74 com warning · <50 rejeitado
MIN_MATCH_SCORE=50
MATCH_SCORE_TRUSTED=75
# Cache de resultado por (supplier_id, normalized_query). TTL = 1h.
ENABLE_SEARCH_CACHE=true

# === Playwright (último fallback, opcional) ===
# Usado APENAS quando fetch direto E Jina falham.
# Não tenta bypass de captcha — se detectar bloqueio, retorna status 'blocked'.
# Para habilitar:
#   cd server && npm install playwright && npx playwright install chromium
#   PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=20000
MAX_PLAYWRIGHT_PAGES_PER_SEARCH=1
