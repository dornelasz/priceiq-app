# ════════════════════════════════════════════════════════
# PriceIQ Server — variáveis de ambiente
# ════════════════════════════════════════════════════════
# Copie para .env e ajuste os valores

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend permitido em CORS
FRONTEND_URL=http://localhost:5173

# === Banco de dados (Postgres) ===
DATABASE_URL=postgresql://priceiq:priceiq@localhost:5432/priceiq

# === Cache (Redis) ===
REDIS_URL=redis://localhost:6379

# === Gemini (OPCIONAL — desligado por padrão) ===
# O PriceIQ NÃO depende de IA. Scrapers + extração direta + Jina + Playwright
# são o motor principal. Gemini é apenas interpretador de fallback opcional.
# Se a chave/quota acabar, a busca SEGUE FUNCIONANDO normalmente.
GEMINI_ENABLED=false
GEMINI_OPTIONAL=true
USE_GEMINI_AS_FALLBACK_ONLY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# === Cotação ===
# Cotação 100% automática via Investing.com
# Não usa Gemini, não usa AwesomeAPI e não usa cotação manual
RATES_CACHE_TTL_SECONDS=60
CURRENCY_REFRESH_INTERVAL_MS=60000
INVESTING_REFRESH_INTERVAL_MS=60000

# === Busca ===
# Motor Universal — usa fetch direto → Jina Reader → Playwright em cascata.
# Não há modos visíveis ao usuário; tudo decide internamente.
#
# Timeout por fornecedor em ms (impede uma falha derrubar toda a busca)
SUPPLIER_TIMEOUT_MS=30000
SCRAPER_TIMEOUT_MS=45000
# Máximo de fornecedores em paralelo
SEARCH_CONCURRENCY=5
# Match score: ≥75 confiável · 50–74 com warning · <50 rejeitado
MIN_MATCH_SCORE=50
MATCH_SCORE_TRUSTED=75
# Cache de resultado por (supplier_id, normalized_query). TTL = 1h.
ENABLE_SEARCH_CACHE=true
