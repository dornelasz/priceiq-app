{
  "name": "@priceiq/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PriceIQ backend — Fastify + Postgres + Redis",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:setup": "tsx db/migrate-cli.ts",
    "db:migrate": "tsx db/migrate-cli.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/reset-cli.ts",
    "smoke:api": "tsx scripts/smokeCatalogApi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
