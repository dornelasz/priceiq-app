# ════════════════════════════════════════════════════════
# PriceIQ — Variáveis de ambiente
# ════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores
# .env NÃO deve ser commitado (já está no .gitignore)

# === Ambiente ===
NODE_ENV=development
PORT=3001

# === Frontend ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# === Banco de dados (Postgres) ===
DATABASE_URL=postgresql://priceiq:priceiq@localhost:5432/priceiq
POSTGRES_USER=priceiq
POSTGRES_PASSWORD=priceiq
POSTGRES_DB=priceiq

# === Cache (Redis) ===
REDIS_URL=redis://localhost:6379

# === Cotação (Investing.com) ===
# Intervalo de atualização da cotação em ms (default 60s)
INVESTING_REFRESH_INTERVAL_MS=60000

# === APIs externas (opcionais — usuário pode fornecer sua própria) ===
GEMINI_API_KEY=
JINA_API_KEY=

# === Autenticação (futuro) ===
JWT_SECRET=change-me-in-production-min-32-chars
SESSION_SECRET=change-me-in-production-min-32-chars

# === Observabilidade (futuro) ===
SENTRY_DSN=
LOG_LEVEL=info
