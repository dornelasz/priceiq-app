# ════════════════════════════════════════════════════════
# PriceIQ — Variáveis de ambiente
# ════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores
# .env NÃO deve ser commitado (já está no .gitignore)

# === Ambiente ===
NODE_ENV=development
PORT=3001

# === Frontend ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# === Banco de dados (Postgres) ===
DATABASE_URL=postgresql://priceiq:priceiq@localhost:5432/priceiq
POSTGRES_USER=priceiq
POSTGRES_PASSWORD=priceiq
POSTGRES_DB=priceiq

# === Cache (Redis) ===
REDIS_URL=redis://localhost:6379

# === Cotação ===
# Fonte principal: AwesomeAPI. Fallback: Investing.com.
# Manual/cache/histórico entram apenas como fallback quando automático falha.
# Intervalo de cache da cotação em segundos (default 60s)
RATES_CACHE_TTL_SECONDS=60
CURRENCY_PRIMARY_SOURCE=awesomeapi
CURRENCY_FALLBACK_SOURCE=investing
CURRENCY_REFRESH_INTERVAL_MS=60000

# === Gemini (OPCIONAL — desligado por padrão) ===
# O PriceIQ NÃO depende de IA. Scrapers + extração direta + Jina + Playwright
# são o motor principal. Gemini é apenas interpretador de fallback opcional.
# Se a chave/quota acabar, a busca SEGUE FUNCIONANDO normalmente.
GEMINI_ENABLED=false
GEMINI_OPTIONAL=true
USE_GEMINI_AS_FALLBACK_ONLY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
JINA_API_KEY=

# === Busca / Scrapers ===
SEARCH_CACHE_MINUTES=30
ENABLE_SEARCH_CACHE=true
MAX_SUPPLIERS_PER_SEARCH=10
SUPPLIER_TIMEOUT_MS=30000
SCRAPER_TIMEOUT_MS=45000
SEARCH_CONCURRENCY=5
MIN_MATCH_SCORE=40

# === Autenticação (futuro) ===
# Troque em produção por valores fortes com 32+ caracteres.
JWT_SECRET=change-me-in-production-min-32-chars
SESSION_SECRET=change-me-in-production-min-32-chars

# === Observabilidade (futuro) ===
SENTRY_DSN=
LOG_LEVEL=info
